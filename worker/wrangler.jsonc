{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartcovoit-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",

  // PRIMARY_API_URL = instance TrueNAS (OSRM réel), FALLBACK_API_URL =
  // instance Railway (repli Haversine). Toutes deux configurées ici, jamais
  // en dur dans le code — cf. docs/deploiement.md.
  //
  // REQUEST_TIMEOUT_MS : filet de sécurité si le primaire reste sans
  // réponse. Doit largement couvrir SOLVER_TIME_LIMIT_S (10s) + l'appel
  // Google Routes + les tracés OSRM par tournée sur un /solve à plusieurs
  // passagers — 12s s'est révélé trop court en pratique (bascule vers
  // Railway, qui répond mais sans OSRM : trafic correct, tracé absent).
  "vars": {
    "PRIMARY_API_URL": "https://smartcovoitlocalapi.qmeyer.fr",
    "FALLBACK_API_URL": "https://smartcovoit-production.up.railway.app",
    "REQUEST_TIMEOUT_MS": "25000"
  },

  // Sans ça, les `console.warn` de bascule (cf. index.ts) ne vont nulle
  // part : jusqu'ici une bascule était totalement invisible, impossible de
  // savoir combien de fois ni pourquoi.
  "observability": {
    "enabled": true
  },

  // Pare-flood à l'edge, avant même d'atteindre un backend (cf.
  // rate-limit.ts) : AUTH pour /auth/* (brute-force), WRITE pour le reste
  // des écritures. `namespace_id` est un identifiant arbitraire, unique
  // dans ce Worker seulement — pas une ressource à créer côté dashboard.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
}
