# Seule URL d'API appelée par le frontend : le Worker de failover, jamais
# directement une instance backend. Valeur publique (elle est intégrée au JS
# envoyé au navigateur), donc versionnée pour que les déploiements soient
# reproductibles — cf. docs/deploiement.md.
NEXT_PUBLIC_API_URL=https://smartcovoit-worker.quentinmeyer57570.workers.dev

# URL canonique du site, utilisée pour les métadonnées (Open Graph,
# sitemap.xml, robots.txt). Domaine personnalisé branché — cf. docs/deploiement.md.
NEXT_PUBLIC_SITE_URL=https://smartcovoit.qmeyer.fr
