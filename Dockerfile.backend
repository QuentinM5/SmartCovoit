# Image backend — FastAPI + OR-Tools.
#
# Multi-stage : les dépendances (dont OR-Tools, volumineux) sont installées
# dans un stage séparé pour garder l'image finale plus légère et profiter du
# cache Docker quand seul le code applicatif change.

FROM python:3.11-slim AS builder

WORKDIR /app

RUN pip install --no-cache-dir --upgrade pip

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

FROM python:3.11-slim

WORKDIR /app

# libpq nécessaire à l'exécution pour certains outils clients Postgres ;
# asyncpg lui-même est pur Python + C compilé au build (déjà dans les wheels).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Site-packages système plutôt que `pip install --user` + `/root/.local` :
# Heroku (container stack) exécute le conteneur SANS privilèges root, avec un
# $HOME différent de `/root` -- `/root/.local` y devient invisible pour
# l'utilisateur réel, d'où un `ModuleNotFoundError` sur alembic au tout
# premier déploiement. Les deux stages partagent la même image de base
# (python:3.11-slim), donc le chemin des site-packages est identique des
# deux côtés, indépendamment de l'utilisateur qui exécute le conteneur.
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
ENV PYTHONUNBUFFERED=1

COPY backend/ .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
