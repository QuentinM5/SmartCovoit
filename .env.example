# Postgres externe (Neon en prod ; en dev local, docker-compose fournit une
# base jetable et cette valeur est ignorée sauf si tu la définis explicitement
# ici pour pointer directement sur Neon depuis ton poste).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vide = pas d'OSRM configuré -> repli automatique sur Haversine (distance à
# vol d'oiseau). Mets une URL (ex. http://osrm:5000) une fois le service OSRM
# du docker-compose démarré avec des données pré-traitées (cf. docs/osrm.md).
OSRM_URL=

# Nominatim impose un User-Agent identifiant l'application (politique
# d'usage officielle) — mets une adresse de contact réelle si tu utilises
# l'instance publique OpenStreetMap.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=smartcovoit-dev/1.0 (ton-email@example.com)

# Limite de temps (secondes) laissée à OR-Tools pour résoudre le VRP.
SOLVER_TIME_LIMIT_S=10

# Origines autorisées pour le frontend, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# Frontend : seule URL d'API que le frontend appelle jamais directement.
NEXT_PUBLIC_API_URL=http://localhost:8000
