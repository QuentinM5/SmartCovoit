# Postgres externe (Neon en prod ; en dev local, docker-compose fournit une
# base jetable et cette valeur est ignorée sauf si tu la définis explicitement
# ici pour pointer directement sur Neon depuis ton poste).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vide = pas d'OSRM configuré -> repli automatique sur Haversine (distance à
# vol d'oiseau). Mets une URL (ex. http://osrm:5000) une fois le service OSRM
# du docker-compose démarré avec des données pré-traitées (cf. docs/osrm.md).
OSRM_URL=

# Vide = pas de trafic temps réel -> repli automatique sur OSRM (durée
# typique) ou Haversine. Clé serveur, distincte de la clé du navigateur
# (NEXT_PUBLIC_GOOGLE_MAPS_API_KEY côté frontend, restreinte par domaine) :
# celle-ci ne doit jamais être exposée au client, restreinte par API (Routes
# API) côté console Google Cloud.
GOOGLE_ROUTES_API_KEY=

# Nominatim impose un User-Agent identifiant l'application (politique
# d'usage officielle) — mets une adresse de contact réelle si tu utilises
# l'instance publique OpenStreetMap.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=smartcovoit-dev/1.0 (ton-email@example.com)

# Limite de temps (secondes) laissée à OR-Tools pour résoudre le VRP.
SOLVER_TIME_LIMIT_S=10

# Origines autorisées pour le frontend, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# Secret de signature des jetons de session (JWT) — OBLIGATOIRE, pas de
# valeur par défaut dans le code : le backend refuse de démarrer sans elle.
# Génère une valeur aléatoire par environnement (ex. `python -c "import
# secrets; print(secrets.token_urlsafe(32))"`), jamais la même entre dev et
# prod, jamais commitée.
JWT_SECRET=

# Identifiant client OAuth Google (public, pas un secret — sert seulement à
# vérifier que le jeton d'identité présenté a été émis pour cette appli).
# Vide = connexion Google désactivée côté backend. Même valeur que
# NEXT_PUBLIC_GOOGLE_CLIENT_ID ci-dessous, créé dans Google Cloud Console
# (API Credentials > OAuth 2.0 Client ID > type "Web application").
GOOGLE_OAUTH_CLIENT_ID=

# Frontend : seule URL d'API que le frontend appelle jamais directement.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend : identifiant client Google exposé au navigateur pour afficher le
# bouton "Se connecter avec Google" (même valeur que GOOGLE_OAUTH_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
